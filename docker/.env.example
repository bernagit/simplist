REGISTRY=ghcr.io/bernagit
# Pin a version (e.g. 0.7.1) to update only when you decide to
VERSION=latest

# Public address of the instance (links in emails, first user and invites)
APP_URL=https://simplist.example.com
CORS_ORIGIN=https://simplist.example.com

# Auth cookies are Secure (HTTPS only). Set to false only for plain HTTP (e.g. on a LAN)
# COOKIE_SECURE=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simplist
POSTGRES_HOST=simplist-db
POSTGRES_PORT=5432

# INVITE GENERATION
INVITE_PER_USER=10

# PUSH NOTIFICATIONS (task reminders)
# Generate a key pair once with `yarn workspace api push:keys` and keep it: changing the keys
# disconnects every device. Leave empty to turn reminders off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact sent to push services (mailto: or https:). Defaults to mailto:MAIL_FROM_EMAIL.
# VAPID_SUBJECT=mailto:admin@example.com

# MAIL SECTION
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=username
SMTP_PASS=password

MAIL_FROM_NAME=Simplist
MAIL_FROM_EMAIL=no-reply@simplist.com