REGISTRY=ghcr.io/bernagit
VERSION=latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simplist
POSTGRES_HOST=simplist-db
POSTGRES_PORT=5432

# INVITE GENERATION
INVITE_PER_USER=10

# PUSH NOTIFICATIONS (task reminders)
# Generate a key pair once with `yarn workspace api push:keys` and keep it: changing the keys
# disconnects every device. Leave empty to turn reminders off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact sent to push services (mailto: or https:). Defaults to mailto:MAIL_FROM_EMAIL.
# VAPID_SUBJECT=mailto:admin@example.com

# MAIL SECTION
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=username
SMTP_PASS=password

MAIL_FROM_NAME=Simplist
MAIL_FROM_EMAIL=no-reply@simplist.com