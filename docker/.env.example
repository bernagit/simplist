# Simplist configuration: put this file next to compose.yaml, named .env

# Version to run: pin it (e.g. 0.7.4) to update only when you decide to
VERSION=latest

# Port of the instance on this server: put your HTTPS reverse proxy in front of it
# HTTP_PORT=3000

# Optional services: "docs" serves the documentation under /docs/
# COMPOSE_PROFILES=docs

# Public address of the instance (links in emails, first user and invites)
APP_URL=https://simplist.example.com
CORS_ORIGIN=https://simplist.example.com

# Auth cookies are Secure (HTTPS only). Set to false only for plain HTTP (e.g. on a LAN)
# COOKIE_SECURE=false

# DATABASE: pick a long random password before the first start (it can't simply be changed later)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simplist
# Installs made with the old docker/docker-compose.*.yml files: reuse their database
# POSTGRES_VOLUME=docker_postgres_data

# INVITE GENERATION
INVITE_PER_USER=10

# PUSH NOTIFICATIONS (task reminders)
# The keys are created on first start in the keys folder (keys/vapid.json): nothing to do.
# Set both only to use your own pair; changing the keys disconnects every device.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact sent to push services (mailto: or https:). Defaults to mailto:MAIL_FROM_EMAIL.
# VAPID_SUBJECT=mailto:admin@example.com

# MAIL (optional): welcome email, email invites and password reset. Uncomment and fill in
# all of SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS and MAIL_FROM_EMAIL to turn it on; if the
# server can't be reached at startup the API logs a warning and keeps running.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=username
SMTP_PASS=password

MAIL_FROM_NAME=Simplist
MAIL_FROM_EMAIL=no-reply@simplist.com