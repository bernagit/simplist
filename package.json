{
  "name": "simplist",
  "version": "0.2.1",
  "packageManager": "yarn@4.12.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "private": true,
  "scripts": {
    "build": "yarn workspaces foreach -A -pt run build",
    "dev": "concurrently -n api,app -c blue,green \"yarn workspace api dev\" \"yarn workspace app dev\"",
    "dev:api": "yarn workspace api run dev",
    "dev:app": "yarn workspace app run dev",
    "clean": "yarn workspaces foreach -A run clean",
    "lint": "yarn workspaces foreach -A -pt run lint",
    "lint:fix": "yarn workspaces foreach -A -pt run lint:fix",
    "format": "prettier --write ./apps",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset version && yarn install",
    "docker:build": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.build.yml up --build",
    "docker:build:down": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.build.yml down",
    "docker:prod": "docker compose --env-file docker/.env -f docker/docker-compose.yml -f docker/docker-compose.prod.yml up",
    "docker:prod:down": "docker compose --env-file docker/.env -f docker/docker-compose.yml -f docker/docker-compose.prod.yml down",
    "docker:image:build": "node scripts/docker-images.mjs build",
    "docker:image:push": "node scripts/docker-images.mjs push",
    "docker:image:release": "node scripts/docker-images.mjs release"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
