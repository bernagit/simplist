{
  "name": "api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "clean": "rm -rf dist",
    "check": "tsc --noEmit && eslint . --ext .ts,.tsx --debug",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:build": "docker build -t simplist-api ."
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.21.0",
    "rrule": "^2.8.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6",
    "@types/cors": "^2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9",
    "@types/morgan": "^1",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-drizzle": "^0.2.3",
    "tsx": "^4.22.4",
    "typescript": "5.9.3"
  }
}
