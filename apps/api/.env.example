APP_URL=http://localhost:3000

PORT=2000
LOG_LEVEL=debug
NODE_ENV=development

CORS_ORIGIN=http://localhost:3000

# Auth cookies are Secure (HTTPS only) unless NODE_ENV=development.
# Set to false only if production is served over plain HTTP (e.g. on a LAN).
# COOKIE_SECURE=false

# DATABASE SECTION
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simplist
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# INVITE GENERATION
INVITE_PER_USER=10

# PUSH NOTIFICATIONS (task reminders)
# The keys are created on first start in the keys folder (keys/vapid.json): nothing to do.
# Set both only to use your own pair; changing the keys disconnects every device.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact sent to push services (mailto: or https:). Defaults to mailto:MAIL_FROM_EMAIL.
# VAPID_SUBJECT=mailto:admin@example.com

# MAIL SECTION
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=username
SMTP_PASS=password

MAIL_FROM_NAME=Simplist
MAIL_FROM_EMAIL=no-reply@simplist.com